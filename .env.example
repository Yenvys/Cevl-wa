# Nomor owner (pake format 62xxx, kalo banyak pisahin pake koma)
OWNER_NUMBERS=628xxx
PAIRING_NUMBER=628xxx

# Contoh: PREFIX=. atau PREFIX=.! (kalo mau banyak)
PREFIX=.

# Google AI Studio API Key
GEMINI_API_KEY=your_gemini_api_key_here
# Versi Model contoh gemini-1.5-flash 
GEMINI_MODEL=gemini-1.5-flash

WOLFRAM_APPID=your_wolfram_appid_here
SERPAPI_KEY=your_serpapi_key_here
JEREXD_API_KEY=your_jerexd_api_key_here

PINTEREST_AUTH_COOKIE=your_pinterest_auth_cookie_here
